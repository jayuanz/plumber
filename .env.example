WEBTERM_USERNAME=admin
WEBTERM_PASSWORD=change-this-long-random-password
SESSION_SECRET=change-this-to-at-least-32-random-bytes

# Set to true when served through HTTPS in production.
COOKIE_SECURE=false

# Comma-separated allowed browser origins. Leave empty to require same-origin.
# Example: https://terminal.example.com
ALLOWED_ORIGINS=

# Optional runtime choices.
WEBTERM_SHELL=
WEBTERM_CWD=
WEBTERM_FORCE_COLOR=true
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=false

# Session and login protection.
SESSION_TTL_MS=28800000
TICKET_TTL_MS=30000
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=8

# Terminal session controls.
MAX_TERMINAL_SESSIONS=4
MAX_TERMINAL_SESSIONS_PER_USER=2
TERMINAL_IDLE_TIMEOUT_MS=1800000
TERMINAL_MAX_SESSION_MS=28800000
MAX_INPUT_BYTES=65536
